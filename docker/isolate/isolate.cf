# Configuration for isolate (https://github.com/ioi/isolate), the sandbox
# the grader runs submissions in with `manage.py grader --isolate`. The
# isolate binary is built to read this file (see dockerfile.grader).

# Where sandboxes are created. This directory and its ancestors must be
# writable only by root.
box_root = /var/local/lib/isolate
lock_root = /run/isolate/locks

# Every run gets its own control group under this one, which
# setup-cgroups.sh creates when the container starts.
cg_root = /sys/fs/cgroup/isolate

# Box N runs as uid/gid 60000+N. Outside the ranges the graders give safeexec
# (SAFEEXEC_UIDS in docker/prod/docker-compose.yml).
first_uid = 60000
first_gid = 60000
num_boxes = 1000
